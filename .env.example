# Ultron Lightweight Agent - Environment Configuration

# LLM Backend: "ollama" (default) or "openai"
ULTRON_LLM_BACKEND=ollama

# Ollama settings (used when ULTRON_LLM_BACKEND=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:latest

# OpenAI settings (used when ULTRON_LLM_BACKEND=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Override base URL to use any OpenAI-compatible API (e.g. LM Studio, Groq)
OPENAI_BASE_URL=

# Memory settings
MEMORY_SHORT_TERM_LIMIT=20
MEMORY_LONG_TERM_FILE=long_term_memory.json

# API server settings
API_HOST=0.0.0.0
API_PORT=8000

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
